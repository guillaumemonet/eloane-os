# Eloane - liste des paquets de l'image live (archiso, x86_64)
# Une entree par ligne ; les lignes vides et commentaires sont ignores par mkarchiso.
# Les providers virtuels (vulkan-driver, lib32-vulkan-driver, ttf-font, jack,
# initramfs...) sont resolus explicitement ici pour que pacstrap ne choisisse
# jamais "au hasard" (pacstrap --noconfirm prendrait le premier provider).

# --- Base systeme / boot live -------------------------------------------------
base
linux
linux-firmware
sof-firmware
intel-ucode
amd-ucode
# provider de "initramfs" (dependance de linux) + hooks archiso
mkinitcpio
mkinitcpio-archiso
sudo
polkit
less
nano
pciutils
usbutils

# --- Graphique ----------------------------------------------------------------
mesa
lib32-mesa
vulkan-icd-loader
lib32-vulkan-icd-loader
# AMD
vulkan-radeon
lib32-vulkan-radeon
# Intel
vulkan-intel
lib32-vulkan-intel
# Logiciel (lavapipe) : permet de booter/afficher dans QEMU sans GPU
vulkan-swrast
lib32-vulkan-swrast
# NVIDIA (modules ouverts, Turing+ ; construit pour le kernel "linux")
nvidia-open
nvidia-utils
lib32-nvidia-utils

# --- Gaming -------------------------------------------------------------------
steam
gamescope
xorg-xwayland
# Repli kiosk wlroots (rendu pixman) pour VM/GPU sans Vulkan : compositor = "cage"
cage
# setcap (hook eloane-gamescope-setcap.hook : CAP_SYS_NICE pour gamescope)
libcap
gamemode
lib32-gamemode
mangohud
lib32-mangohud

# --- Audio (PipeWire) -----------------------------------------------------------
pipewire
pipewire-pulse
pipewire-alsa
# provider de "jack" (evite jack2)
pipewire-jack
lib32-pipewire
lib32-pipewire-jack
wireplumber
alsa-utils

# --- Reseau / Bluetooth --------------------------------------------------------
networkmanager
wpa_supplicant
wireless-regdb
bluez
bluez-utils

# --- Polices (provider de "ttf-font" demande par steam) -------------------------
ttf-liberation
noto-fonts
